# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
#
# ── Modo de funcionamiento ────────────────────────────────────────────────────
# remote = datos en Supabase vía /api/rpc (producción).  local = solo navegador (localStorage, demo).
VITE_BACKEND=remote

# ── Supabase (solo servidor; NO llevan prefijo VITE_) ─────────────────────────
# Supabase → Project Settings → API:  "Project URL" y la clave "service_role" (secreta).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=

# ── Seguridad (solo servidor) ─────────────────────────────────────────────────
# Cadena larga y aleatoria para firmar sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET=
# PIN del panel de administrador. ¡Cámbialo por uno que no sea obvio!
ADMIN_PIN=
# Secreto que debe enviar el cron de recordatorios (Authorization: Bearer ...).
CRON_SECRET=
# URL pública del sitio, para los enlaces de WhatsApp (opcional; si falta se deduce de la petición).
PUBLIC_BASE_URL=

# ── WhatsApp automático (opcional; sin esto el admin envía manualmente con un clic) ─
WHATSAPP_MODE=manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Solo para pruebas locales sin Supabase ────────────────────────────────────
# VITE_BACKEND=local  y  VITE_ADMIN_PIN=1234
